# FinWise AI Environment Configuration
# Copy this file to .env and customize the values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_random_secure_hex_key_generate_with_python_secrets

# Database Configuration
# Default is local SQLite in instance/ directory
DATABASE_URL=sqlite:///instance/finwise.db
# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/finwise_db

# Google Gemini AI Integration
# Leave blank to use the built-in intelligent rule-based fallback advisor
GEMINI_API_KEY=
# Configurable model name (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Default Financial Settings
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
